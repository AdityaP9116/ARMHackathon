*.dll
*.o
*.a
build/

# Models / data (do not commit large weights or MRI data)
*.safetensors
*.pt
*.pth
*.ckpt
/data/
/models/
/checkpoints/

# Golden vectors: core cases ARE committed (1D in tests/golden/, 2D cross-scan
# in tests/golden/2d/); large benchmark-shaped ones are regenerated on demand
# via `python tests/gen_golden.py --large`
tests/golden/large_*.npz

# Demo run outputs (images, metrics, locally trained priors)
demo_out/

# fastMRI: the Data Sharing Agreement forbids redistributing the data OR the
# signed download links. Nothing derived from it goes in the repo — not raw
# .h5, not extracted archives, not the preprocessed cache.
/data/
*.h5
*.tar.xz
knee_singlecoil_*
brain_multicoil_*

# Benchmark outputs
*.csv
*.log
/results/

# Wheel build outputs
python/dist/
wheel-test-env/

# Benchmark result files (JSONs are per-host; commit deliberately if
# they're headline numbers)
bench/results/

# OS / editor
.DS_Store
.idea/
.vscode/
